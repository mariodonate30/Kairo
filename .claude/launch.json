{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kairo-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5183",
        "--strictPort"
      ],
      "port": 5183,
      "autoPort": true
    },
    {
      "name": "panel-hipotesis",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "panel",
        "--",
        "--strictPort"
      ],
      "port": 5184
    },
    {
      "name": "public-panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "public-panel",
        "--",
        "--strictPort"
      ],
      "port": 5185
    },
    {
      "name": "public-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--config",
        "public-panel/vite.config.js",
        "--port",
        "5186",
        "--strictPort"
      ],
      "port": 5186
    }
  ]
}
